# resume-tailor credentials. Read automatically on every run; a value already
# exported in your shell wins over this file.
#
# Keep this file private — it holds an API key.

RESUME_TAILOR_PROVIDER=openai          # openai | anthropic
OPENAI_API_KEY=PASTE-YOUR-KEY-HERE

# RESUME_TAILOR_MODEL=gpt-5.2          # uncomment to override the provider's default model
# RESUME_TAILOR_CONCURRENCY=2          # model calls in flight at once; keep low on a free/low rate-limit tier
# ANTHROPIC_API_KEY=                   # for the anthropic provider (or use `ant auth login` instead)
# RESUME_TAILOR_AUDIT_MODEL=o3-mini    # send the many small audit checks to a model with a roomier rate limit

# RESUME_TAILOR_JUDGE_MODEL=           # the two pre-submission match judges, if not the main model
# RESUME_TAILOR_HEADLESS=1             # hide the browser; leave unset while you are still watching it work
# RESUME_TAILOR_PROFILE=~/.resume-tailor   # where career.yaml / answers.yaml live
# RESUME_TAILOR_OUTPUT=./output            # where PDFs, screenshots and batch state go

# Site accounts. Only hosts listed in answers.yaml -> search.create_accounts_on
# get an account created (Workday needs one and does not confirm by e-mail).
# The password is generated once and stored here; never commit this file.
# RESUME_TAILOR_SITE_PASSWORD=

# Mailbox, for forms that e-mail a one-time code or a "continue" link before
# they show the application (Oracle, Pella, some iCIMS). IMAP over SSL; for
# Gmail use an app password (Google account -> Security -> App passwords).
# RESUME_TAILOR_IMAP_USER=you@gmail.com
# RESUME_TAILOR_IMAP_PASSWORD=xxxx xxxx xxxx xxxx
# RESUME_TAILOR_IMAP_HOST=imap.gmail.com

{
  "name": "resume-tailor",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "workspaceFolder": "/app",
  "mounts": [
    "source=${localEnv:HOME}/.resume-tailor,target=/root/.resume-tailor,type=bind,consistency=cached"
  ],
  "postCreateCommand": "pip install -e . && for t in tests/test_*.py; do python \"$t\" | tail -1; done",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "/usr/bin/python3" }
    }
  }
}

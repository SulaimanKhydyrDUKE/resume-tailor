# resume-tailor reads these from ~/.resume-tailor/env (one KEY=value per line;
# a shell export wins over the file). This file documents the keys; copy it
# there and fill in what you use. Never commit the filled-in file.
# See profile/env.example for the same keys with longer comments.

# Model provider: anthropic (default) or openai, and the API key for it.
RESUME_TAILOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                      # also needed by mail scanning and recruiter search, whatever the provider

# Models. RESUME_TAILOR_<ROLE>_MODEL overrides per role: main, audit, judge.
RESUME_TAILOR_MODEL=
RESUME_TAILOR_AUDIT_MODEL=
RESUME_TAILOR_MAIL_MODEL=            # inbox classifier (default gpt-4o)
RESUME_TAILOR_SEARCH_MODEL=          # recruiter-address web search (default gpt-4o)

# Mailbox the tool reads for one-time codes, confirmations and assessments,
# and sends recruiter notes from: a Gmail address and an app password.
RESUME_TAILOR_IMAP_USER=
RESUME_TAILOR_IMAP_PASSWORD=

# One password for the portal accounts the tool may create (search.create_accounts_on in answers.yaml).
RESUME_TAILOR_SITE_PASSWORD=

# Optional
RESUME_TAILOR_CONCURRENCY=4          # in-flight model calls per provider
RESUME_TAILOR_DEBUG=                 # 1 for verbose account/search notes
